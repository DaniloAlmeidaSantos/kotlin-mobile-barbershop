<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white"
    tools:context=".ui.activity.FormAuthenticateActivity">

    <!-- Logo da barbearia -->
    <ImageView
        android:id="@+id/imageLogoLogin"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="Logo Babershop"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo de E-mail -->
    <EditText
        android:id="@+id/form_authenticate_email_activity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="E-mail"
        android:drawableStart="@drawable/ic_user"
        android:padding="16dp"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/imageLogoLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Campo de Senha -->
    <EditText
        android:id="@+id/form_authenticate_secret_activity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Senha"
        android:drawableStart="@drawable/ic_password"
        android:padding="16dp"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/form_authenticate_email_activity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/form_authenticate_btn_register"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Botão Acessar -->
    <Button
        android:id="@+id/form_authenticate_button_authenticate_activity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Acessar"
        android:backgroundTint="#218838"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/form_authenticate_secret_activity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/form_authenticate_btn_register"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cadastra-se"
        android:backgroundTint="@color/black"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/form_authenticate_button_authenticate_activity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>




    <!-- Marca de Desenvolvedor -->
    <TextView
        android:id="@+id/textViewDeveloper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desenvolvido por Danilo Almeida"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
